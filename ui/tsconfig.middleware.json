{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true
  },
  "include": [
    "middleware.ts",
    "src/lib/seo/seoMeta.ts",
    "src/lib/seo/seoMiddleware.ts",
    "src/lib/seo/siteOrigin.ts",
    "src/lib/seo/publicRoutes.ts",
    "src/lib/seo/content/staticPageCopy.ts",
    "src/lib/seo/snapshot/renderSnapshot.ts"
  ]
}
